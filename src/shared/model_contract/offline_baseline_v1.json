{
  "version": "offline-pytorch-hierarchical-v1",
  "status": "software_baseline_only_not_a_frozen_hardware_protocol",
  "source_input_layout": "K,H,W,C",
  "source_image_dtype": "little_endian_float32",
  "source_mask_dtype": "uint8_0_or_1",
  "shape": [8, 128, 128, 1],
  "spatial_reference": "official_OASIS1_T88_111_distribution_grid",
  "world_origin": "not_verified_do_not_use_Analyze_fallback_affine_as_anatomical_coordinates",
  "mask": "official_FSL_SEG_positive_labels_1_2_3_nearest_neighbor",
  "raw_scale": "power_of_two_fitted_only_on_current_training_partition_shared_by_D_and_S",
  "percentiles": [1, 99],
  "percentile_method": "linear_over_all_K_masked_float_pixels_before_int16_encoding",
  "integer_rounding": "nearest_ties_to_even_for_r_L_H_M",
  "input_mapping": "q=clip((clip(int64(r)-L,0,H-L)*M+32768)>>16,0,255);z=q/256",
  "background": "r=L_then_q=0",
  "overflow": "fail_session_no_clipping_or_refitting_on_validation_test",
  "training_layout": "NCHW",
  "grid_head_flatten_order": "HWC",
  "D_class_order": ["no_dementia", "dementia"],
  "S_class_order": ["very_mild_CDR0.5", "mild_or_above_valid_CDR1_2"],
  "aggregation": "mean_two_logits_over_all_K_slices_then_sigmoid_difference",
  "thresholds": {"D": 0.5, "S": 0.5},
  "threshold_tie": "positive_class",
  "D_negative": "do_not_run_S;severity_fields_null;final_class_0",
  "D_positive": "always_run_S_on_same_K_slices_and_normalization",
  "S_failure": "preserve_D;severity_and_final_class_null;status_partial_failure",
  "scope": "no_FPGA_network_quantization_or_board_execution_claim"
}
