                    <string>Optional on a direct PC connection</string>
                  </property>
                </widget>
              </item>
              <item row="4" column="1">
                <widget class="QPushButton" name="apply">
                  <property name="text">
                    <string>Apply network settings</string>
                  </property>
                </widget>
              </item>
              <item row="5" column="0" colspan="2">
                <widget class="QLabel" name="networkNote">
                  <property name="text">
                    <string>Changes apply until reboot. Changing the IP disconnects existing sessions.</string>
                  </property>
                  <property name="styleSheet">
                    <string>font-size:12px; color:#738199;</string>
                  </property>
                  <property name="wordWrap">
                    <bool>true</bool>
                  </property>
                </widget>
              </item>
            </layout>
          </widget>
          <widget class="QWidget" name="toolsPage">
            <attribute name="title">
              <string>Tools</string>
            </attribute>
            <layout class="QVBoxLayout" name="toolsLayout">
              <property name="leftMargin">
                <number>0</number>
              </property>
              <property name="topMargin">
                <number>4</number>
              </property>
              <property name="rightMargin">
                <number>0</number>
              </property>
              <property name="bottomMargin">
                <number>0</number>
              </property>
              <property name="spacing">
                <number>10</number>
              </property>
              <item>
                <layout class="QHBoxLayout" name="toolsCards" stretch="2,3">
                  <property name="spacing">
                    <number>10</number>
                  </property>
                  <item>
                    <widget class="QFrame" name="pairCard">
                      <property name="styleSheet">
                        <string>QFrame#pairCard {background:white; border:1px solid #e5eaf2; border-radius:12px;}</string>
                      </property>
                      <layout class="QVBoxLayout" name="pairLayout">
                        <property name="leftMargin">
                          <number>14</number>
                        </property>
                        <property name="rightMargin">
                          <number>14</number>
                        </property>
                        <property name="topMargin">
                          <number>14</number>
                        </property>
                        <property name="bottomMargin">
                          <number>14</number>
                        </property>
                        <property name="spacing">
                          <number>8</number>
                        </property>
                        <item>
                          <widget class="QLabel" name="pairTitle">
                            <property name="text">
                              <string>DOCTOR PAIRING</string>
                            </property>
                            <property name="styleSheet">
                              <string>font-size:12px; font-weight:bold; color:#657893;</string>
                            </property>
                          </widget>
                        </item>
                        <item>
                          <widget class="QLabel" name="pairHint">
                            <property name="text">
                              <string>Connect a computer with a one-time code.</string>
                            </property>
                            <property name="wordWrap">
                              <bool>true</bool>
                            </property>
                            <property name="styleSheet">
                              <string>font-size:12px; color:#738199;</string>
                            </property>
                          </widget>
                        </item>
                        <item>
                          <widget class="QLabel" name="pairCode">
                            <property name="text">
                              <string>------</string>
                            </property>
                            <property name="alignment">
                              <set>Qt::AlignCenter</set>
                            </property>
                            <property name="minimumSize">
                              <size>
                                <width>0</width>
                                <height>58</height>
                              </size>
                            </property>
                            <property name="styleSheet">
                              <string>font-size:38px; font-weight:bold; color:#2864e9;</string>
                            </property>
                          </widget>
                        </item>
                        <item>
                          <widget class="QLabel" name="pairStatus">
                            <property name="text">
                              <string>No active code. Generate one below.</string>
                            </property>
                            <property name="wordWrap">
                              <bool>true</bool>
                            </property>
                            <property name="minimumSize">
                              <size>
                                <width>0</width>
                                <height>40</height>
                              </size>
                            </property>
                            <property name="styleSheet">
                              <string>font-size:12px; color:#738199;</string>
                            </property>
                          </widget>
                        </item>
                        <item>
                          <widget class="QPushButton" name="pairButton">
                            <property name="text">
                              <string>Generate pairing code</string>
                            </property>
                            <property name="styleSheet">
                              <string>QPushButton {background:#2864e9; color:white; border:0;} QPushButton:disabled {background:#edf1f7; color:#9aa7ba;}</string>
                            </property>
                          </widget>
                        </item>
                      </layout>
                    </widget>
                  </item>
                  <item>
                    <widget class="QFrame" name="usbCard">
                      <property name="styleSheet">
                        <string>QFrame#usbCard {background:white; border:1px solid #e5eaf2; border-radius:12px;}</string>
                      </property>
                      <layout class="QVBoxLayout" name="usbLayout">
                        <property name="leftMargin">
                          <number>14</number>
                        </property>
                        <property name="rightMargin">
                          <number>14</number>
                        </property>
                        <property name="topMargin">
                          <number>14</number>
                        </property>
                        <property name="bottomMargin">
                          <number>14</number>
                        </property>
                        <property name="spacing">
                          <number>8</number>
                        </property>
                        <item>
                          <widget class="QLabel" name="usbTitle">
                            <property name="text">
                              <string>USB EXPORT</string>
                            </property>
                            <property name="styleSheet">
                              <string>font-size:12px; font-weight:bold; color:#657893;</string>
                            </property>
                          </widget>
                        </item>
                        <item>
                          <widget class="QLabel" name="usbCase">
                            <property name="text">
                              <string>Waiting for a completed case</string>
                            </property>
                            <property name="minimumSize">
                              <size>
                                <width>0</width>
                                <height>22</height>
                              </size>
                            </property>
                            <property name="styleSheet">
                              <string>font-size:13px; font-weight:bold;</string>
                            </property>
                          </widget>
                        </item>
                        <item>
                          <widget class="QComboBox" name="usbDevices">
                            <item>
                              <property name="text">
                                <string>No USB storage detected</string>
                              </property>
                            </item>
                          </widget>
                        </item>
                        <item>
                          <widget class="QLabel" name="usbStatus">
                            <property name="text">
                              <string>Insert mounted USB storage to export the current completed case.</string>
                            </property>
                            <property name="wordWrap">
                              <bool>true</bool>
                            </property>
                            <property name="minimumSize">
                              <size>
                                <width>0</width>
                                <height>58</height>
                              </size>
                            </property>
                            <property name="maximumSize">
                              <size>
                                <width>16777215</width>
                                <height>58</height>
                              </size>
                            </property>
                            <property name="styleSheet">
                              <string>font-size:12px; color:#738199;</string>
                            </property>
                          </widget>
                        </item>
                        <item>
                          <layout class="QHBoxLayout" name="usbActions">
                            <item>
                              <widget class="QPushButton" name="usbRefresh">
                                <property name="text">
                                  <string>Refresh</string>
                                </property>
                              </widget>
                            </item>
                            <item>
                              <widget class="QPushButton" name="usbExport">
                                <property name="text">
                                  <string>Export current case</string>
                                </property>
                                <property name="enabled">
                                  <bool>false</bool>
                                </property>
                                <property name="styleSheet">
                                  <string>QPushButton {background:#2864e9; color:white; border:0;} QPushButton:disabled {background:#edf1f7; color:#9aa7ba;}</string>
                                </property>
                              </widget>
                            </item>
                          </layout>
                        </item>
                      </layout>
                    </widget>
                  </item>
                </layout>
              </item>
              <item>
                <widget class="QFrame" name="clockCard">
                  <property name="styleSheet">
                    <string>QFrame#clockCard {background:white; border:1px solid #e5eaf2; border-radius:12px;}</string>
                  </property>
                  <layout class="QHBoxLayout" name="clockLayout">
                    <property name="leftMargin">
                      <number>14</number>
                    </property>
                    <property name="rightMargin">
                      <number>14</number>
                    </property>
                    <item>
                      <widget class="QLabel" name="systemClock">
                        <property name="text">
                          <string>---- -- --   --:--:--</string>
                        </property>
                        <property name="styleSheet">
                          <string>font-size:19px; font-weight:bold;</string>
                        </property>
                      </widget>
                    </item>
                    <item>
                      <widget class="QLabel" name="rtcStatus">
                        <property name="text">
                          <string>RTC status unavailable</string>
                        </property>
                        <property name="alignment">
                          <set>Qt::AlignRight|Qt::AlignVCenter</set>
                        </property>
                        <property name="styleSheet">
                          <string>font-size:12px; color:#738199;</string>
                        </property>
                      </widget>
                    </item>
                  </layout>
                </widget>
              </item>
            </layout>
          </widget>
        </widget>
      </item>
      <item>
        <widget class="QLabel" name="result">
          <property name="text">
            <string>Case management and detailed review are available on the computer.</string>
          </property>
          <property name="styleSheet">
            <string>font-size:11px; color:#8290a5;</string>
          </property>
          <property name="minimumSize">
            <size>
              <width>0</width>
              <height>18</height>
            </size>
          </property>
          <property name="maximumSize">
            <size>
              <width>16777215</width>
              <height>18</height>
            </size>
          </property>
          <property name="wordWrap">
            <bool>false</bool>
          </property>
        </widget>
      </item>
    </layout>
  </widget>
