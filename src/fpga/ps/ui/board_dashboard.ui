          </widget>
          <widget class="QWidget" name="settingsPage">
            <attribute name="title">
              <string>Network</string>
            </attribute>
            <layout class="QGridLayout" name="settingsLayout">
              <property name="leftMargin">
                <number>16</number>
              </property>
              <property name="topMargin">
                <number>16</number>
              </property>
              <property name="rightMargin">
                <number>16</number>
              </property>
              <property name="bottomMargin">
                <number>16</number>
              </property>
              <property name="spacing">
                <number>10</number>
              </property>
              <item row="0" column="0">
                <widget class="QLabel" name="networkCaption0">
                  <property name="text">
                    <string>Address mode</string>
                  </property>
                  <property name="styleSheet">
                    <string>color:#738199;</string>
                  </property>
                </widget>
              </item>
              <item row="0" column="1">
                <widget class="QComboBox" name="mode">
                  <item>
                    <property name="text">
                      <string>DHCP</string>
                    </property>
                  </item>
                  <item>
                    <property name="text">
                      <string>Static IPv4</string>
                    </property>
                  </item>
                </widget>
              </item>
              <item row="1" column="0">
                <widget class="QLabel" name="networkCaption1">
                  <property name="text">
                    <string>IPv4 address</string>
                  </property>
                  <property name="styleSheet">
                    <string>color:#738199;</string>
                  </property>
                </widget>
              </item>
              <item row="1" column="1">
                <widget class="AddressEdit" name="ipInput">
                  <property name="enabled">
                    <bool>false</bool>
                  </property>
                  <property name="maxLength">
                    <number>15</number>
                  </property>
                  <property name="placeholderText">
                    <string>192.168.1.50</string>
                  </property>
                </widget>
              </item>
              <item row="2" column="0">
                <widget class="QLabel" name="networkCaption2">
                  <property name="text">
                    <string>Netmask</string>
                  </property>
                  <property name="styleSheet">
                    <string>color:#738199;</string>
                  </property>
                </widget>
              </item>
              <item row="2" column="1">
                <widget class="AddressEdit" name="maskInput">
                  <property name="enabled">
                    <bool>false</bool>
                  </property>
                  <property name="maxLength">
                    <number>15</number>
                  </property>
                  <property name="text">
                    <string>255.255.255.0</string>
                  </property>
