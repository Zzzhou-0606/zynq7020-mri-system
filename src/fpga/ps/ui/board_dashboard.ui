    <property name="styleSheet">
      <string>QWidget {font-family: "DejaVu Sans"; font-size:14px; color:#26344b; background:transparent;}
QWidget#BoardDashboard {background:#f3f6fb;}
QLabel {background:transparent; border:0;}
QFrame#imageCard, QFrame#progressCard, QFrame#resultCard {background:white; border:1px solid #e5eaf2; border-radius:12px;}
QTabWidget::pane {border:0; background:transparent;}
QTabBar::tab {min-height:24px; padding:8px 22px; margin-right:6px; border:0; border-radius:8px; color:#738199; background:transparent;}
QTabBar::tab:selected {background:#2864e9; color:white;}
QTabBar::tab:!selected:hover {background:#e8eef9;}
QLineEdit,QComboBox {min-height:36px; border:1px solid #dce3ee; border-radius:8px; padding:0 10px; background:white;}
QLineEdit:disabled {background:#edf1f7; color:#9aa7ba;}
QComboBox::drop-down {width:32px; border:0;}
QComboBox QAbstractItemView {min-height:40px; background:white; selection-background-color:#2864e9;}
QPushButton {min-height:40px; border:1px solid #dce3ee; border-radius:8px; background:white; padding:0 16px;}
QPushButton:pressed {background:#e8effc;}
QPushButton#apply {background:#2864e9; color:white; border:0;}
QPushButton:disabled {color:#9aa7ba; background:#edf1f7;}
QProgressBar {border:0; border-radius:3px; background:#edf1f7;}
QProgressBar::chunk {background:#2864e9; border-radius:3px;}
QDialog {background:#f3f6fb;}</string>
